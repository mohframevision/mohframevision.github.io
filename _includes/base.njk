{% from "icon.njk" import icon %}
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
  <!-- الإعدادات الأساسية -->
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta http-equiv="X-UA-Compatible" content="IE=edge">
  <!-- يكبّر الصفحة بالتناسب على الشاشات العريضة — لازم قبل أول رسم -->
  <script src="js/fit.js?v={{ buildTime }}"></script>

  <!-- Google Search Console Verification -->
  <meta name="google-site-verification" content="ovYyi0AFK7ZaPy_Do3z0VH4rU5Po34l8A5qjzZQlp6A" />

  <!-- Google AdSense -->
  {% if adsense.publisherId %}
  <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client={{ adsense.publisherId }}" crossorigin="anonymous"></script>
  {% endif %}

  <!-- SEO Meta Tags -->
  <title>{{ title }}</title>
  {% if not skipMeta %}
  {% if canonical == "" %}
  <link rel="canonical" href="{{ site.url }}/">
  {% else %}
  <link rel="canonical" href="{{ site.url }}/{{ canonical }}">
  {% endif %}
  {% endif %}
  {% if description %}<meta name="description" content="{{ description }}">{% endif %}
  {% if keywords %}<meta name="keywords" content="{{ keywords }}">{% endif %}
  {% if author %}<meta name="author" content="{{ author }}">{% endif %}
  <meta name="robots" content="{{ robotsMeta or "index, follow" }}">

  {% if not skipMeta %}
  <!-- Open Graph Tags -->
  <meta property="og:type" content="{{ ogType or "website" }}">
  <meta property="og:title" content="{{ ogTitle or title }}">
  <meta property="og:description" content="{{ ogDescription or description }}">
  {% if canonical == "" %}
  <meta property="og:url" content="{{ site.url }}">
  {% else %}
  <meta property="og:url" content="{{ site.url }}/{{ canonical }}">
  {% endif %}
  {% if siteName %}
  <meta property="og:site_name" content="Mohamed Frame Vision">
  <meta property="og:locale" content="ar_AR">
  {% endif %}
  <meta property="og:image" content="{{ ogImage or site.defaultOgImage }}">
  <meta property="og:image:width" content="{{ ogImageWidth or 1200 }}">
  <meta property="og:image:height" content="{{ ogImageHeight or 630 }}">
  {% endif %}

  {% if twitterCard %}
  <!-- Twitter Card Tags -->
  <meta name="twitter:card" content="{{ twitterCard }}">
  <meta name="twitter:title" content="{{ twitterTitle or ogTitle or title }}">
  <meta name="twitter:description" content="{{ twitterDescription or ogDescription or description }}">
  <meta name="twitter:image" content="{{ twitterImage or ogImage or site.defaultOgImage }}">
  {% endif %}

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="favicon.svg">
  <link rel="icon" type="image/png" sizes="32x32" href="favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="favicon-16x16.png">
  <link rel="shortcut icon" href="favicon.ico">
  <link rel="apple-touch-icon" sizes="180x180" href="apple-touch-icon.png">
  <link rel="manifest" href="site.webmanifest">

  {% if youtubePreconnect %}
  <!-- تسريع تحميل فيديوهات يوتيوب -->
  <link rel="preconnect" href="https://www.youtube-nocookie.com">
  <link rel="preconnect" href="https://www.youtube.com">
  <link rel="preconnect" href="https://i.ytimg.com">
  {% endif %}

  <!-- خط عربي احترافي (300 إضافي للعناوين الكبيرة) + خط سيريف إنجليزي للمسات
       التحريرية (اقتباس "About" والنص الإنجليزي الفرعي) — Playfair Display
       ما له حروف عربية أصلاً، فيسقط تلقائياً على Cairo بأي نص عربي يستخدمه -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">

  <!-- Stylesheet -->
  {# بالتطوير (eleventy --serve) الملف الأصلي مباشرة: styles.min.css ما
     يتولّد إلا بـnpm run build (scripts/minify-css.js)، فكان التطوير يعرض
     نسخة قديمة محفوظة بالمستودع وأي تعديل CSS ما يبين #}
  <link rel="stylesheet" href="css/{{ 'styles.css' if eleventy.env.runMode == 'serve' else 'styles.min.css' }}?v={{ buildTime }}">

  {% if schemaJSON %}
  <!-- بيانات منظمة لمحركات البحث (Schema.org) -->
  <script type="application/ld+json">
  {{ schemaJSON | safe }}
  </script>
  {% endif %}
</head>

<body>
  <a class="skip-link" href="#main">تخطَّ إلى المحتوى</a>

  <!-- شريط التنقل -->
  <header class="nav">
    <div class="nav-inner">
      <a class="nav-brand" href="index.html">Mohamed Frame Vision</a>
      <nav class="nav-links" id="navLinks" aria-label="التنقل الرئيسي">
        {% for item in site.nav %}
        <a href="{{ item.href }}"{% if item.href == navActive %} class="active" aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
      <div class="nav-tools">
        <button type="button" class="nav-icon-btn sound-toggle" aria-pressed="false" aria-label="تشغيل المؤثرات الصوتية" title="تشغيل المؤثرات الصوتية">{{ icon("volume-off", 22) }}</button>
        <button type="button" class="nav-icon-btn nav-toggle" aria-expanded="false" aria-controls="navLinks" aria-label="فتح القائمة">{{ icon("menu", 22) }}</button>
      </div>
    </div>
  </header>

  <main id="main">
  {{ content | safe }}
  </main>

  <!-- التذييل -->
  <footer{% if footerFixed %} class="footer-fixed"{% endif %}>
    {% if footerFixed %}
    <p>&copy; 2026 Mohamed Frame Vision</p>
    {% else %}
    <p>© 2026 Mohamed Frame Vision - جميع الحقوق محفوظة</p>
    <p class="footer-links">
      <a href="contact.html">تواصل معنا</a>
      <a href="about.html">عن الموقع</a>
      <a href="privacy-policy.html">سياسة الخصوصية</a>
      <a href="terms.html">شروط الاستخدام</a>
    </p>
    <p class="footer-license">
      المحتوى مرخص تحت
      <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/" target="_blank" rel="noopener">CC BY-NC-SA 4.0</a>
      - ممنوع الاستخدام التجاري
    </p>
    {% endif %}
  </footer>

  <!-- زر العودة للأعلى -->
  <button type="button" id="scrollToTop" aria-label="العودة للأعلى">{{ icon("arrow-up", 22) }}</button>

  <!-- JavaScript -->
  <script src="js/script.js?v={{ buildTime }}"></script>
</body>
</html>
