---
{% from "icon.njk" import icon %}
  <h1 class="home-tagline"><span class="sr-only">Mohamed Frame Vision — </span>محرر فيديو · مونتاج يعكس هوية علامتك</h1>

  <!-- رصّة الأعمال ثلاثية الأبعاد (Unveil): عجلة الماوس/السحب تتنقل بينها،
       والضغط يفتح الفيديو. البطاقات أزرار حقيقية (لوحة المفاتيح/قارئ الشاشة) -->
  <section class="stack-stage" aria-label="أعمالي">
    <div class="stack" id="workStack">
      {% for p in projectList %}
      <button type="button" class="stack-card" data-index="{{ loop.index0 }}" data-youtube="{{ p.youtubeId }}" data-title="{{ p.title }}" data-desc="{{ p.description }}" aria-label="{{ p.title }} — تشغيل الفيديو">
        <img src="https://i.ytimg.com/vi/{{ p.youtubeId }}/hqdefault.jpg" alt="" width="480" height="360" decoding="async"{% if loop.index0 > 5 %} loading="lazy"{% endif %}>
      </button>
      {% endfor %}
    </div>
    <div class="stack-label" id="stackLabel" aria-hidden="true"></div>
  </section>

  <!-- عنوان العمل الحالي ورقمه (يفيد باللمس حيث ما فيه مرور ماوس) -->
  <p class="stack-caption" id="stackCaption" aria-live="polite"></p>
  <p class="stack-hint" id="stackHint">مرّر أو اسحب للتنقل بين الأعمال</p>

  <!-- عرض القائمة (INDEX): روابط يوتيوب حقيقية، تشتغل بلا جافاسكربت -->
  <div class="stack-index" id="stackIndex" hidden>
    <ol>
      {% for p in projectList %}
      <li><a href="https://www.youtube.com/watch?v={{ p.youtubeId }}" target="_blank" rel="noopener" data-index="{{ loop.index0 }}">
        <span class="stack-index-num">{{ ("0" + loop.index) if loop.index < 10 else loop.index }}</span>
        <span class="stack-index-title">{{ p.title }}</span>
        <span class="stack-index-desc">{{ p.description }}</span>
      </a></li>
      {% endfor %}
    </ol>
  </div>
  <noscript><style>.stack-stage,.view-switch,.stack-hint{display:none}.stack-index{display:block!important}</style></noscript>

  <div class="view-switch" role="group" aria-label="طريقة العرض">
    <button type="button" class="view-btn active" data-view="stack" aria-pressed="true">معرض</button>
    <button type="button" class="view-btn" data-view="index" aria-pressed="false">قائمة</button>
  </div>

  <!-- مشغّل الفيديو -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-labelledby="lightboxTitle" hidden>
    <div class="lightbox-inner">
      <div class="lightbox-video"><iframe id="lightboxFrame" title="" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen></iframe></div>
      <div class="lightbox-meta">
        <h2 id="lightboxTitle"></h2>
        <p id="lightboxDesc"></p>
      </div>
      <button type="button" class="nav-tile lightbox-close" id="lightboxClose" aria-label="إغلاق">{{ icon("close", 20) }}</button>
    </div>
  </div>
