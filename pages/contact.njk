{% from "icon.njk" import icon %}
  <!-- قسم التواصل -->
  <section class="section" style="padding-top: 120px; min-height: 100vh;">
    <h1 class="page-title">تواصل معي</h1>
    <p class="page-intro">
      لديك مشروع؟ أريد أن أسمع عنه! املأ النموذج أدناه أو تواصل معي مباشرة
    </p>

    <div style="display: grid; grid-template-columns: 1fr; gap: 40px; max-width: 1000px; margin: 0 auto;">
      <!-- نموذج التواصل -->
      <div>
        <!-- رسائل النجاح والخطأ -->
        <div id="formMessage" style="display: none; padding: 15px; border-radius: 8px; margin-bottom: 20px; text-align: center;"></div>

        <form id="contactForm" class="contact-form" action="https://api.web3forms.com/submit" method="POST">
          <!-- Web3Forms Access Key -->
          <input type="hidden" name="access_key" value="a2dc8bb2-0fb8-47a9-8b58-ad3245d3f5a3">

          <!-- إعدادات Web3Forms -->
          <input type="hidden" name="subject" value="رسالة جديدة من موقع Mohamed Frame Vision">
          <input type="hidden" name="from_name" value="Mohamed Frame Vision Contact Form">
          <input type="hidden" name="redirect" value="https://web3forms.com/success">

          <!-- Honeypot للحماية من السبام -->
          <input type="checkbox" name="botcheck" class="hidden" style="display: none;">

          <div class="form-group">
            <label for="name">الاسم *</label>
            <input type="text" id="name" name="name" required placeholder="اسمك الكريم" minlength="2" maxlength="100">
          </div>

          <div class="form-group">
            <label for="email">البريد الإلكتروني *</label>
            <input type="email" id="email" name="email" required placeholder="example@email.com">
          </div>

          <div class="form-group">
            <label for="subject_text">موضوع الرسالة</label>
            <input type="text" id="subject_text" name="subject_text" placeholder="ما هو موضوع رسالتك؟" maxlength="200">
          </div>

          <div class="form-group">
            <label for="message">الرسالة *</label>
            <textarea id="message" name="message" required placeholder="اكتب رسالتك هنا..." minlength="10" maxlength="5000"></textarea>
          </div>

          <button type="submit" id="submitBtn" class="btn" style="width: 100%; margin-top: 10px;">
            <span id="btnText">إرسال الرسالة</span>
            <span id="btnLoading" style="display: none;">جاري الإرسال...</span>
          </button>
        </form>
      </div>

      <!-- معلومات التواصل المباشر -->
      <div style="text-align: center;">
        <div class="contact-panel">
          <h3 style="font-size: 24px; margin-bottom: 30px;">طرق التواصل المباشر</h3>

          <a class="contact-method" href="mailto:mohframevision@outlook.com">
            <span class="contact-method-icon">{{ icon("mail", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">البريد الإلكتروني</span><span class="contact-method-value">mohframevision@outlook.com</span></span>
          </a>

          <a class="contact-method" href="https://wa.me/97339006824" target="_blank" rel="noopener">
            <span class="contact-method-icon">{{ icon("chat", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">واتساب</span><span class="contact-method-value">تواصل عبر واتساب</span></span>
          </a>

          <a class="contact-method" href="https://youtube.com/@mohframevision" target="_blank" rel="noopener">
            <span class="contact-method-icon">{{ icon("smart-display", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">يوتيوب</span><span class="contact-method-value">@mohframevision</span></span>
          </a>

          <a class="contact-method" href="https://www.instagram.com/mohframevision" target="_blank" rel="noopener">
            <span class="contact-method-icon">{{ icon("photo-camera", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">إنستقرام</span><span class="contact-method-value">@mohframevision</span></span>
          </a>

          <a class="contact-method" href="https://www.tiktok.com/@mohframevision" target="_blank" rel="noopener">
            <span class="contact-method-icon">{{ icon("music-note", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">تيك توك</span><span class="contact-method-value">@mohframevision</span></span>
          </a>

          <a class="contact-method" href="https://linktr.ee/f5r.tr" target="_blank" rel="noopener">
            <span class="contact-method-icon">{{ icon("language", 26) }}</span>
            <span class="contact-method-text"><span class="contact-method-label">كل الروابط</span><span class="contact-method-value">linktr.ee/f5r.tr</span></span>
          </a>

          <div style="margin-top: 30px; padding-top: 30px; border-top: 1px solid #222;">
            <p style="color: var(--text-muted); font-size: 14px; line-height: 1.8;">
              أعد بالرد خلال 24 ساعة<br>
              من الأحد إلى الخميس
            </p>
          </div>
        </div>

        <!-- أزرار إضافية -->
        <div class="actions">
          <a href="projects.html" class="btn">شاهد أعمالي</a>
          <a href="services.html" class="btn">الخدمات</a>
        </div>
      </div>
    </div>
  </section>
